{
  "buildCommand": "npm run build",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/acb-static/:path*", "destination": "https://static.acb.com/:path*" },
    { "source": "/(.*)", "destination": "/app" }
  ]
}
